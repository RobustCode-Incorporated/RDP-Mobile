# Copy to .env (git-ignored) and adjust. Expo inlines EXPO_PUBLIC_* values into
# the JS bundle at build time, so NEVER put secrets in EXPO_PUBLIC_* variables.
#
# Backend API base URL. If unset: dev builds use the local backend
# (Android emulator http://10.0.2.2:8080, iOS simulator http://127.0.0.1:8080),
# release builds use the hosted Render backend.
# Physical device on the same Wi-Fi: use your machine's LAN IP, e.g. http://192.168.1.20:8080
# Hosted backend: https://rdp-backend-xr8r.onrender.com
EXPO_PUBLIC_API_BASE_URL=

# Optional telemetry endpoint (leave empty to disable).
EXPO_PUBLIC_DRIVER_TELEMETRY_ENDPOINT=
